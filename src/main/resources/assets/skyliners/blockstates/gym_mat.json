{
  "multipart": [
    {
      "apply": {
        "model": "skyliners:block/gym_mat"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "skyliners:block/gym_mat_piping"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "skyliners:block/gym_mat_piping",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "skyliners:block/gym_mat_piping",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "skyliners:block/gym_mat_piping",
        "y": 270
      }
    }
  ]
}
