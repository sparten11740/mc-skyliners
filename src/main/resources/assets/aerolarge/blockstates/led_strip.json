{
  "multipart": [
    {
      "when": {
        "north": "true",
        "ceiling": "false"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_floor",
        "y": 0
      }
    },
    {
      "when": {
        "north": "true",
        "ceiling": "true"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_ceiling",
        "y": 0
      }
    },
    {
      "when": {
        "east": "true",
        "ceiling": "false"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_floor",
        "y": 90
      }
    },
    {
      "when": {
        "east": "true",
        "ceiling": "true"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_ceiling",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true",
        "ceiling": "false"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_floor",
        "y": 180
      }
    },
    {
      "when": {
        "south": "true",
        "ceiling": "true"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_ceiling",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true",
        "ceiling": "false"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_floor",
        "y": 270
      }
    },
    {
      "when": {
        "west": "true",
        "ceiling": "true"
      },
      "apply": {
        "model": "aerolarge:block/led_strip_ceiling",
        "y": 270
      }
    }
  ]
}
